# Copy to `.env` (which is git-ignored) and adjust locally.
#
# This project is research-only. Live trading is never enabled from research
# code; these variables exist so that data download and dry-run tooling can be
# pointed at an exchange without committing credentials.

# Path to a freqtrade source checkout. Required when freqtrade is not installed.
FREQTRADE_SRC=C:/path/to/freqtrade-develop

# Automation bridge (all optional; never contains secrets).
# PA_BRIDGE_PYTHON selects the research interpreter explicitly (the bare
# `python` on PATH may be an unrelated virtualenv).
PA_BRIDGE_PYTHON=
# OpenCode is only invoked when the bridge is run with -WithOpenCode.
OPENCODE_BIN=
OPENCODE_MODEL=
OPENCODE_AGENT=
PA_BRIDGE_TIMEOUT_S=600

# Exchange credentials for PUBLIC data download only.
# Leave empty to use unauthenticated public endpoints. Never commit real keys.
PA_EXCHANGE=
PA_API_KEY=
PA_API_SECRET=
